# Microsoft Fabric Warehouse connection (same warehouse SEMANTIC-LAYER uses)
FABRIC_DB_HOST=<fabric-host>
FABRIC_DB_PORT=1433
FABRIC_DB_NAME=<fabric-warehouse-name>
FABRIC_DB_USER=<fabric-user>
FABRIC_DB_PASS=<fabric-password>

# In-house SFTP server — capture photos and planogram files live here, not
# on this VM's disk. Always the hostname, never the resolved IP.
SFTP_HOST=sftp.arvindbrands.com
SFTP_PORT=22
SFTP_USER=<sftp-user>
SFTP_PASS=<sftp-password>
SFTP_ROOT=money_mapping_uploads
